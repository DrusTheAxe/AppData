@ECHO Off
SETLOCAL

IF %1x == x GoTo Help

SET VERSION=%1

ECHO === MakeZIP Version=%VERSION% ===

SET ROOTDIR=%~dp0..\..
SET BINDIR=%ROOTDIR%\bin\Release
SET BINEXE_X86=%BINDIR%\x86\AppData\net10.0-windows10.0.17763.0\win-x86\native\appdata.exe
SET BINEXE_X64=%BINDIR%\x64\AppData\net10.0-windows10.0.17763.0\win-x64\native\appdata.exe
SET BINEXE_ARM64=%BINDIR%\arm64\AppData\net10.0-windows10.0.17763.0\win-arm64\native\appdata.exe
SET TARGETDIR=%ROOTDIR%\Release
SET TARGETBASE=%TARGETDIR%\AppData-%VERSION%

SET SCRATCH="%TEMP%\appxdata-temp-zip"
IF EXIST %SCRATCH% RD /s/q %SCRATCH%
MD %SCRATCH% 2>&1 >NUL
MD %SCRATCH%\docs\images 2>&1 >NUL
MD %SCRATCH%\x86 2>&1 >NUL
MD %SCRATCH%\x64 2>&1 >NUL
MD %SCRATCH%\arm64 2>&1 >NUL
COPY %ROOTDIR%\docs\images\DownloadFromTheMicrosoftStore.png %SCRATCH%\docs\images\*
COPY %BINEXE_X86%           %SCRATCH%\x86\*
COPY %BINEXE_X64%           %SCRATCH%\x64\*
COPY %BINEXE_ARM64%         %SCRATCH%\arm64\*
COPY %ROOTDIR%\LICENSE      %SCRATCH%\*
COPY %ROOTDIR%\README.html  %SCRATCH%\*
COPY %ROOTDIR%\README.md    %SCRATCH%\*

IF "%ZIPEXE%" == "" SET ZIPEXE=C:\Util.W32\ZIP.EXE
SET ZOPTS=-9rDX
SET ZTARGET=%TARGETBASE%.zip
SET FILES=*

IF NOT EXIST %TARGETDIR% MD %TARGETDIR% 2>&1 >NUL
IF EXIST %ZTARGET% DEL /Q %ZTARGET%
ECHO === MakeZIP Version=%VERSION% === Making %ZTARGET%... ===
CD /D %SCRATCH%
ECHO %ZIPEXE% %ZOPTS% %ZTARGET% %FILES%
%ZIPEXE% %ZOPTS% %ZTARGET% %FILES%
IF ERRORLEVEL 1 GOTO TheEnd

IF "%_7ZDIR%" == "" SET _7ZDIR=C:\Util.W32\7-ZipPortable\App
IF "%_7Zx86%" == "" SET _7Zx86=%_7ZDIR%\7-Zip\7z.exe
IF "%_7Zx64%" == "" SET _7Zx64=%_7ZDIR%\7-Zip64\7z.exe
SET _7ZEXE=%_7Zx86%
IF %PROCESSOR_ARCHITECTURE% == AMD64 SET _7ZEXE=%_7Zx64%
SET _7ZOPTS=-mx=9 -myx=9 -sse
SET _7ZTARGET=%TARGETBASE%.7z

IF EXIST %_7ZTARGET% DEL /Q %_7ZTARGET%
ECHO === Make7z Version=%VERSION% === Making %_7ZTARGET%... ===
ECHO %_7ZEXE% a %_7ZOPTS% %_7ZTARGET% %FILES%
%_7ZEXE% a %_7ZOPTS% %_7ZTARGET% %FILES%
IF ERRORLEVEL 1 GOTO TheEnd

GoTo TheEnd

:Help
ECHO Usage: MAKEZIP version

:TheEnd
ENDLOCAL
